{
    "experiment_name": "ad_brain_age_gap_prediction",
    "description": "Regional brain age prediction for ADNI AD/MCI cohort using VCDA-Net",
    "data": {
        "features_dir": "../../../../data/ad_prediction/features/regions",
        "metadata_file": "../../../../data/ad_prediction/features/metadata.csv",
        "models_dir": "../../../../data/ad_prediction/models/models",
        "bias_params_file": "../../../../data/ad_prediction/models/bias_correction/regional_bias_correction_params.json",
        "note": "Paths are relative to this config file location"
    },
    "model": {
        "num_regions": 32,
        "apply_bias_correction": true,
        "ensemble_method": "mean"
    },
    "output": {
        "output_dir": "results",
        "predictions_file": "predictions_adni_ad_mci.csv",
        "statistics_file": "predictions_adni_ad_mci_statistics.json",
        "save_per_region": true,
        "save_ensemble": true,
        "note": "Output directory is relative to experiment directory"
    },
    "cohorts": {
        "adni_ad": {
            "description": "Alzheimer's Disease patients",
            "expected_delta_age_range": [
                2.0,
                8.0
            ]
        },
        "adni_mci": {
            "description": "Mild Cognitive Impairment patients",
            "expected_delta_age_range": [
                1.0,
                5.0
            ]
        }
    },
    "analysis": {
        "calculate_group_statistics": true,
        "perform_statistical_tests": true,
        "generate_visualizations": false
    }
}