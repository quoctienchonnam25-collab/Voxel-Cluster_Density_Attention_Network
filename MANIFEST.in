# Include documentation
include README.md
include LICENSE
include CHANGELOG.md
include NAMING_CLARIFICATION.md

# Include requirements
include requirements.txt

# Include scripts
recursive-include scripts *.py *.sh

# Include configs
recursive-include src/vcda_net/configs *.yaml *.json

# Include checkpoints (optional - comment out if too large)
# recursive-include src/vcda_net/checkpoints *.pth

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.so
global-exclude .git*
global-exclude .coverage
global-exclude .pytest_cache

# Exclude build artifacts
prune build
prune dist
prune *.egg-info
